  "design_servo_overrides": {
    "why": "Pivots and axes are kept exactly as measured. Two servo BODIES are turned to a different orientation about their own pivot because the Micro X skull is a T-rex head, not a duck head; the kinematics are unchanged.",
    "head_roll": {
      "reference_d": [
        0,
        -1,
        0
      ],
      "micro_x_d": [
        0,
        0,
        1
      ],
      "reason": "long axis vertical so the body stays inside the narrow rear of the skull instead of spanning it sideways"
    },
    "jaw": {
      "reference_d": [
        1,
        0,
        0
      ],
      "micro_x_d": [
        -1,
        0,
        0
      ],
      "pivot_moved_mm": [
        0,
        7.0,
        3.4
      ],
      "reason": "body points back into the wide part of the skull; the pivot moves outboard and up so the beak arm clears the head-yaw servo and the mouth opens further"
    }
  }
